.env
*.env.local
*.env.production

# ── Keys / credentials (NEVER commit) ──────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa*
id_ed25519*
rich-prod-key.pem
.ssh/

